# .env.example
# ==========================================
# VARIÁVEIS DE AMBIENTE - BIBLIOTECA DO SABER
# ==========================================

# ========== Django ==========
SECRET_KEY=django-insecure-mude-esta-chave-em-producao-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000

# ========== Banco de Dados (PostgreSQL) ==========
DATABASE_URL=postgresql://postgres:2530@localhost:5432/biblioteca_do_saber

POSTGRES_DB=biblioteca_do_saber
POSTGRES_USER=postgres
POSTGRES_PASSWORD="sua senha_aqui"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ========== Redis (opcional) ==========
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_CHANNEL_URL=redis://localhost:6379/2

# ========== Email ==========
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@biblioteca.com

# ========== APIs Externas ==========
GOOGLE_BOOKS_API_KEY=

# ========== Segurança ==========
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ========== Celery ==========
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========== PWA ==========
PWA_APP_NAME=Biblioteca do Saber
PWA_APP_DESCRIPTION=Plataforma inclusiva de troca de livros
PWA_APP_THEME_COLOR=#2c6b8f
PWA_APP_BACKGROUND_COLOR=#ffffff

# ========== Sentry (Monitoramento) ==========
SENTRY_DSN=
