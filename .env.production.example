# .env.production.example
# ==============================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO
# ==============================================

# ========== Django ==========
SECRET_KEY=gere-uma-chave-segura-com-50-caracteres-aleatorios
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com
BASE_URL=https://seudominio.com

# ========== PostgreSQL ==========
DATABASE_URL=postgresql://usuario:senha@db:5432/biblioteca_saber?sslmode=require
POSTGRES_DB=biblioteca_saber
POSTGRES_USER=biblioteca_user
POSTGRES_PASSWORD=senha-super-segura-aqui
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ========== Redis ==========
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CHANNEL_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ========== Email (produção) ==========
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=sua-api-key-sendgrid
DEFAULT_FROM_EMAIL=nao-responda@seudominio.com
SENDGRID_API_KEY=sua-api-key-sendgrid

# ========== APIs Externas ==========
GOOGLE_BOOKS_API_KEY=sua-chave-google-books
VIA_CEP_URL=https://viacep.com.br/ws
VLIBRAS_URL=https://vlibras.gov.br/app

# ========== Segurança (PRODUÇÃO = True) ==========
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
CORS_ALLOWED_ORIGINS=https://seudominio.com
CSRF_TRUSTED_ORIGINS=https://seudominio.com

# ========== Sentry (opcional) ==========
SENTRY_DSN=
